{
  "expo": {
    "name": "Calculator",
    "slug": "nazar",
    "scheme": "calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F7F7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simplecalc.app"
    },
    "android": {
      "package": "com.simplecalc.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8EAED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F7"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "This app uses Bluetooth to scan for nearby devices only while you are on the scan screen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app reads photos you choose, on this device only, to check them for hidden location data. Nothing is uploaded."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "If you turn on intruder capture, this app uses the front camera to take a photo after repeated wrong-PIN attempts. The photo stays encrypted on this device and is never uploaded.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
